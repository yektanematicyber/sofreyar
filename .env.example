# Database connection string
DATABASE_URL=postgresql://safreyar:safreyar_secret_password@localhost:5432/safreyar

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# Rate Limiting (true/false)
RATE_LIMIT_ENABLED=true

# SMTP Real Email Service (e.g. Gmail, Mailtrap, Amazon SES, Najva)
# Leave empty for development/mock mode (token will be logged in console/returned in JSON)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@safreyar.com
SMTP_FROM_NAME=سفره‌یار (Safreyar)
SMTP_TLS=true

# Docker PostgreSQL configuration
POSTGRES_USER=safreyar
POSTGRES_PASSWORD=safreyar_secret_password
POSTGRES_DB=safreyar
