# Database connection string
DATABASE_URL=postgresql://safreyar:safreyar_secret_password@localhost:5432/safreyar

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker PostgreSQL configuration
POSTGRES_USER=safreyar
POSTGRES_PASSWORD=safreyar_secret_password
POSTGRES_DB=safreyar
