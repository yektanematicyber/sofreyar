# Database connection string
DATABASE_URL=postgresql://safreyar:safreyar_secret_password@localhost:5432/safreyar

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# Rate Limiting (true/false)
RATE_LIMIT_ENABLED=true

# SMTP Real Email Service (e.g. Gmail, Mailtrap, Amazon SES, Najva)
# Leave empty for development/mock mode (token will be logged in console/returned in JSON)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@safreyar.com
SMTP_FROM_NAME=سفره‌یار (Safreyar)
SMTP_TLS=true

# Docker PostgreSQL configuration
POSTGRES_USER=safreyar
POSTGRES_PASSWORD=safreyar_secret_password
POSTGRES_DB=safreyar

# LLM Meal Suggestion Configuration
LLM_MODE=fake
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60.0

# Recipe Suggestion Caching (Hours)
RECIPE_CACHE_EXPIRE_HOURS=24.0

# Suggestion Per-User Rate Limiting
SUGGESTIONS_RATE_LIMIT_TIMES=10
SUGGESTIONS_RATE_LIMIT_SECONDS=60

# Optional Redis connection URL (e.g. redis://localhost:6379/0)
REDIS_URL=

# LLM Telemetry Pricing Configuration (USD per 1 Million Tokens)
LLM_PRICE_INPUT_PER_MILLION=3.0
LLM_PRICE_OUTPUT_PER_MILLION=15.0
